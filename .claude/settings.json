{
  "model": "sonnet",
  "fallbackModel": ["opus", "sonnet"],
  "permissions": {
    "deny": [
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/keystore.properties)",
      "Read(./.env)",
      "Read(./**/*.env)",
      "Edit(./.github/release-signing-cert.sha256)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\""
          }
        ]
      }
    ]
  }
}
